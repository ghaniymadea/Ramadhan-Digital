<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.RamadhanDigital" parent="Theme.MaterialComponents.Light.NoActionBar">

        <!-- Warna Utama Header -->
        <item name="colorPrimary">@color/green_header</item>
        <item name="colorPrimaryVariant">@color/green_status_bar</item>
        <item name="colorSecondary">@color/gold_text</item>

        <item name="colorOnPrimary">@color/white</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Warna Background Layar -->
        <item name="android:windowBackground">@color/app_background</item>

        <!-- Warna Status Bar -->
        <item name="android:statusBarColor">@color/green_status_bar</item>
        <item name="android:navigationBarColor">@color/white</item>

        <!-- Ikon status bar putih karena background hijau gelap -->
        <item name="android:windowLightStatusBar">false</item>

        <item name="bottomNavigationStyle">@style/App.BottomNavigationView</item>
    </style>

    <style name="App.BottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemActiveIndicatorStyle">@style/App.Custom.Indicator</item>
        <item name="itemTextAppearanceActive">@style/App.BottomNav.Text.Active</item>
        <item name="itemTextAppearanceInactive">@style/App.BottomNav.Text.Inactive</item>
        <item name="itemIconTint">@color/bottom_nav_color_state</item>
        <item name="itemTextColor">@color/bottom_nav_color_state</item>
        <item name="backgroundTint">@color/white</item>
    </style>

    <style name="App.Custom.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <!-- Background hijau transparan (10% opacity) untuk item aktif -->
        <item name="android:color">@color/bottom_nav_indicator</item>
        <item name="android:width">60dp</item>
        <item name="android:height">40dp</item>
    </style>

    <style name="App.BottomNav.Text.Active" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">serif</item>
    </style>

    <style name="App.BottomNav.Text.Inactive" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">serif</item>
    </style>

    <style name="HeaderTitleStyle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/gold_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:fontFamily">serif</item>
    </style>

</resources>