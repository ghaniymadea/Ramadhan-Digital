<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9FAFB">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:navigationIconTint="#004D40" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ibadah Sunnah"
                android:textColor="#111827"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-"
                android:textColor="#6B7280"
                android:textSize="14sp" />
        </LinearLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Progress Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeWidth="1dp"
                app:strokeColor="#F3F4F6">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Progress Sunnah"
                            android:textColor="#111827"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvProgressCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="0/5 Selesai"
                            android:textColor="#059669"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </RelativeLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressIndicator"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:progress="0"
                        app:indicatorColor="#059669"
                        app:trackColor="#ECFDF5"
                        app:trackCornerRadius="4dp"
                        app:trackThickness="8dp" />

                    <TextView
                        android:id="@+id/tvProgressMsg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Ayo perbanyak amalan sunnahmu!"
                        android:textColor="#6B7280"
                        android:textSize="12sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Daftar Amalan Sunnah"
                android:textColor="#111827"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="100dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeWidth="1dp"
                app:strokeColor="#F3F4F6">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- 1. Tarawih -->
                    <RelativeLayout
                        android:id="@+id/itemTarawih"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:padding="16dp">
                        <ImageView
                            android:id="@+id/ivCheckTarawih"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_unchecked_circle" />
                        <TextView
                            android:id="@+id/tvTitleTarawih"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="16dp"
                            android:layout_toEndOf="@id/ivCheckTarawih"
                            android:text="Sholat Tarawih"
                            android:textColor="#1F2937"
                            android:textSize="16sp" />
                        <TextView
                            android:id="@+id/tvStatusTarawih"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/tvTitleTarawih"
                            android:layout_marginStart="16dp"
                            android:layout_toEndOf="@id/ivCheckTarawih"
                            android:textColor="#059669"
                            android:textSize="12sp"
                            android:text="Selesai"
                            android:visibility="gone" />
                    </RelativeLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F3F4F6"/>

                    <!-- 2. Witir -->
                    <RelativeLayout
                        android:id="@+id/itemWitir"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:padding="16dp">
                        <ImageView
                            android:id="@+id/ivCheckWitir"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_unchecked_circle" />
                        <TextView
                            android:id="@+id/tvTitleWitir"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="16dp"
                            android:layout_toEndOf="@id/ivCheckWitir"
                            android:text="Sholat Witir"
                            android:textColor="#1F2937"
                            android:textSize="16sp" />
                        <TextView
                            android:id="@+id/tvStatusWitir"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/tvTitleWitir"
                            android:layout_marginStart="16dp"
                            android:layout_toEndOf="@id/ivCheckWitir"
                            android:textColor="#059669"
                            android:textSize="12sp"
                            android:text="Selesai"
                            android:visibility="gone" />
                    </RelativeLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F3F4F6"/>

                    <!-- 3. Dhuha -->
                    <RelativeLayout
                        android:id="@+id/itemDhuha"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:padding="16dp">
                        <ImageView
                            android:id="@+id/ivCheckDhuha"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_unchecked_circle" />
                        <TextView
                            android:id="@+id/tvTitleDhuha"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="16dp"
                            android:layout_toEndOf="@id/ivCheckDhuha"
                            android:text="Sholat Dhuha"
                            android:textColor="#1F2937"
                            android:textSize="16sp" />
                        <TextView
                            android:id="@+id/tvStatusDhuha"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/tvTitleDhuha"
                            android:layout_marginStart="16dp"
                            android:layout_toEndOf="@id/ivCheckDhuha"
                            android:textColor="#059669"
                            android:textSize="12sp"
                            android:text="Selesai"
                            android:visibility="gone" />
                    </RelativeLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F3F4F6"/>

                    <!-- 4. Tahajud -->
                    <RelativeLayout
                        android:id="@+id/itemTahajud"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:padding="16dp">
                        <ImageView
                            android:id="@+id/ivCheckTahajud"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_unchecked_circle" />
                        <TextView
                            android:id="@+id/tvTitleTahajud"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="16dp"
                            android:layout_toEndOf="@id/ivCheckTahajud"
                            android:text="Sholat Tahajud"
                            android:textColor="#1F2937"
                            android:textSize="16sp" />
                        <TextView
                            android:id="@+id/tvStatusTahajud"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/tvTitleTahajud"
                            android:layout_marginStart="16dp"
                            android:layout_toEndOf="@id/ivCheckTahajud"
                            android:textColor="#059669"
                            android:textSize="12sp"
                            android:text="Selesai"
                            android:visibility="gone" />
                    </RelativeLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F3F4F6"/>

                    <!-- 5. Sedekah -->
                    <RelativeLayout
                        android:id="@+id/itemSedekah"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:padding="16dp">
                        <ImageView
                            android:id="@+id/ivCheckSedekah"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_unchecked_circle" />
                        <TextView
                            android:id="@+id/tvTitleSedekah"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="16dp"
                            android:layout_toEndOf="@id/ivCheckSedekah"
                            android:text="Sedekah Harian"
                            android:textColor="#1F2937"
                            android:textSize="16sp" />
                        <TextView
                            android:id="@+id/tvStatusSedekah"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/tvTitleSedekah"
                            android:layout_marginStart="16dp"
                            android:layout_toEndOf="@id/ivCheckSedekah"
                            android:textColor="#059669"
                            android:textSize="12sp"
                            android:text="Selesai"
                            android:visibility="gone" />
                    </RelativeLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSimpan"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        android:backgroundTint="#004D40"
        android:text="Simpan Progress Sunnah"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        app:iconGravity="textStart"
        app:iconPadding="8dp" />

    <ProgressBar
        android:id="@+id/loadingBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
