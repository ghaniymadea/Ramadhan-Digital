<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <!-- ================= HEADER ================= -->

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:background="@drawable/bg_header_gradient"
            android:paddingTop="8dp"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:navigationIconTint="@color/white"
            app:title="Ibadah Hari Ini"
            app:titleCentered="true"
            app:titleTextAppearance="@style/HeaderTitleStyle"
            app:titleTextColor="@color/gold_text" />

        <!-- Date Badge -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="-12dp"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp">

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp"
                android:text="12 Ramadhan 1445 H"
                android:textColor="@color/luxury_emerald"
                android:textSize="12sp"
                android:textStyle="bold" />

        </com.google.android.material.card.MaterialCardView>

    </com.google.android.material.appbar.AppBarLayout>


    <!-- ================= CONTENT ================= -->

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- ================= PROGRESS CARD ================= -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Progress Hari Ini"
                            android:textColor="@color/text_title"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvProgressCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="0/6 Selesai"
                            android:textColor="@color/green_success"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </RelativeLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressIndicator"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:progress="0"
                        app:indicatorColor="@color/luxury_emerald"
                        app:trackColor="@color/green_light_bg"
                        app:trackCornerRadius="4dp"
                        app:trackThickness="8dp" />

                    <TextView
                        android:id="@+id/tvProgressMsg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Ayo mulai ibadahmu hari ini!"
                        android:textColor="@color/text_body"
                        android:textSize="12sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================= SHOLAT WAJIB ================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Sholat Wajib"
                android:textColor="@color/text_title"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="serif" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/divider_line"
                    android:orientation="vertical"
                    android:showDividers="middle">


                    <!-- ================= SUBUH ================= -->

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <ImageView
                            android:id="@+id/ivCheckSubuh"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_alignParentStart="true"
                            android:layout_alignParentTop="true"
                            android:src="@drawable/ic_unchecked_circle"
                            app:tint="@color/luxury_emerald" />

                        <TextView
                            android:id="@+id/tvTitleSubuh"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_toEndOf="@id/ivCheckSubuh"
                            android:text="Subuh"
                            android:textColor="@color/text_title"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <Spinner
                            android:id="@+id/spStatusSubuh"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/tvTitleSubuh"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="8dp"
                            android:layout_toEndOf="@id/ivCheckSubuh"
                            android:background="@drawable/bg_dropdown_pill"
                            android:spinnerMode="dropdown" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentTop="true"
                            android:text="04:30"
                            android:textColor="@color/text_muted"
                            android:textSize="14sp" />

                    </RelativeLayout>


                    <!-- ================= DZUHUR ================= -->

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <ImageView
                            android:id="@+id/ivCheckDzuhur"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_unchecked_circle"
                            app:tint="@color/luxury_emerald" />

                        <TextView
                            android:id="@+id/tvTitleDzuhur"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_toEndOf="@id/ivCheckDzuhur"
                            android:text="Dzuhur"
                            android:textColor="@color/text_title"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <Spinner
                            android:id="@+id/spStatusDzuhur"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/tvTitleDzuhur"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="8dp"
                            android:layout_toEndOf="@id/ivCheckDzuhur"
                            android:background="@drawable/bg_dropdown_pill" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentTop="true"
                            android:text="12:00"
                            android:textColor="@color/text_muted"
                            android:textSize="14sp" />

                    </RelativeLayout>


                    <!-- ================= ASHAR ================= -->

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <ImageView
                            android:id="@+id/ivCheckAshar"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_unchecked_circle"
                            app:tint="@color/luxury_emerald" />

                        <TextView
                            android:id="@+id/tvTitleAshar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_toEndOf="@id/ivCheckAshar"
                            android:text="Ashar"
                            android:textColor="@color/text_title"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <Spinner
                            android:id="@+id/spStatusAshar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/tvTitleAshar"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="8dp"
                            android:layout_toEndOf="@id/ivCheckAshar"
                            android:background="@drawable/bg_dropdown_pill" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentTop="true"
                            android:text="15:15"
                            android:textColor="@color/text_muted"
                            android:textSize="14sp" />

                    </RelativeLayout>


                    <!-- ================= MAGHRIB ================= -->

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <ImageView
                            android:id="@+id/ivCheckMaghrib"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_unchecked_circle"
                            app:tint="@color/luxury_emerald" />

                        <TextView
                            android:id="@+id/tvTitleMaghrib"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_toEndOf="@id/ivCheckMaghrib"
                            android:text="Maghrib"
                            android:textColor="@color/text_title"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <Spinner
                            android:id="@+id/spStatusMaghrib"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/tvTitleMaghrib"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="8dp"
                            android:layout_toEndOf="@id/ivCheckMaghrib"
                            android:background="@drawable/bg_dropdown_pill" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentTop="true"
                            android:text="18:10"
                            android:textColor="@color/text_muted"
                            android:textSize="14sp" />

                    </RelativeLayout>


                    <!-- ================= ISYA ================= -->

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <ImageView
                            android:id="@+id/ivCheckIsya"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_unchecked_circle"
                            app:tint="@color/luxury_emerald" />

                        <TextView
                            android:id="@+id/tvTitleIsya"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_toEndOf="@id/ivCheckIsya"
                            android:text="Isya"
                            android:textColor="@color/text_title"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <Spinner
                            android:id="@+id/spStatusIsya"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/tvTitleIsya"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="8dp"
                            android:layout_toEndOf="@id/ivCheckIsya"
                            android:background="@drawable/bg_dropdown_pill" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentTop="true"
                            android:text="19:20"
                            android:textColor="@color/text_muted"
                            android:textSize="14sp" />

                    </RelativeLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================= MEMBACA AL-QUR'AN ================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Membaca Al-Qur'an"
                android:textColor="@color/text_title"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="serif" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="80dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:id="@+id/ivCheckQuran"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_unchecked_circle"
                            app:tint="@color/luxury_emerald" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="12dp"
                            android:layout_toEndOf="@id/ivCheckQuran"
                            android:text="Status Membaca"
                            android:textColor="@color/text_title"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/quran"
                            app:tint="@color/luxury_emerald" />

                    </RelativeLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@color/bg_gray"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Target Hari Ini (Sura/Ayat):"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/etTargetQuran"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:background="@android:color/transparent"
                            android:hint="Contoh: Al-Baqarah 1-10"
                            android:inputType="text"
                            android:padding="4dp"
                            android:textColor="@color/text_title"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


    <!-- ================= BUTTON SIMPAN ================= -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSimpan"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        android:backgroundTint="@color/luxury_emerald"
        android:text="Simpan Progress"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_save"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconTint="@color/white" />


    <!-- ================= LOADING ================= -->

    <ProgressBar
        android:id="@+id/loadingBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/luxury_emerald"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
