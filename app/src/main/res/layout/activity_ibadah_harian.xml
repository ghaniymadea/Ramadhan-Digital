<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9FAFB">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_back"
            app:navigationIconTint="#004D40" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ibadah Hari Ini"
                android:textColor="#111827"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12 Ramadhan 1445 H"
                android:textColor="#6B7280"
                android:textSize="14sp" />
        </LinearLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Progress Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeWidth="1dp"
                app:strokeColor="#F3F4F6">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Progress Hari Ini"
                            android:textColor="#111827"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvProgressCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="0/6 Selesai"
                            android:textColor="#059669"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </RelativeLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressIndicator"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:progress="0"
                        app:indicatorColor="#059669"
                        app:trackColor="#ECFDF5"
                        app:trackCornerRadius="4dp"
                        app:trackThickness="8dp" />

                    <TextView
                        android:id="@+id/tvProgressMsg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Ayo mulai ibadahmu hari ini!"
                        android:textColor="#6B7280"
                        android:textSize="12sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Sholat Wajib"
                android:textColor="#111827"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeWidth="1dp"
                app:strokeColor="#F3F4F6">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/divider_line"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <!-- Subuh -->
                    <RelativeLayout
                        android:id="@+id/itemSubuh"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:padding="16dp">
                        <ImageView
                            android:id="@+id/ivCheckSubuh"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_unchecked_circle" />
                        <TextView
                            android:id="@+id/tvTitleSubuh"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="16dp"
                            android:layout_toEndOf="@id/ivCheckSubuh"
                            android:text="Subuh"
                            android:textColor="#1F2937"
                            android:textSize="16sp" />
                        <TextView
                            android:id="@+id/tvStatusSubuh"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/tvTitleSubuh"
                            android:layout_marginStart="16dp"
                            android:layout_toEndOf="@id/ivCheckSubuh"
                            android:textColor="#EF4444"
                            android:textSize="12sp"
                            android:visibility="gone"
                            tools:text="Belum"
                            tools:visibility="visible" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:text="04:30"
                            android:textColor="#9CA3AF"
                            android:textSize="14sp" />
                    </RelativeLayout>

                    <!-- Dzuhur -->
                    <RelativeLayout
                        android:id="@+id/itemDzuhur"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:padding="16dp">
                        <ImageView
                            android:id="@+id/ivCheckDzuhur"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_unchecked_circle" />
                        <TextView
                            android:id="@+id/tvTitleDzuhur"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="16dp"
                            android:layout_toEndOf="@id/ivCheckDzuhur"
                            android:text="Dzuhur"
                            android:textColor="#1F2937"
                            android:textSize="16sp" />
                        <TextView
                            android:id="@+id/tvStatusDzuhur"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/tvTitleDzuhur"
                            android:layout_marginStart="16dp"
                            android:layout_toEndOf="@id/ivCheckDzuhur"
                            android:textColor="#EF4444"
                            android:textSize="12sp"
                            android:visibility="gone" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:text="12:00"
                            android:textColor="#9CA3AF"
                            android:textSize="14sp" />
                    </RelativeLayout>

                    <!-- Ashar -->
                    <RelativeLayout
                        android:id="@+id/itemAshar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:padding="16dp">
                        <ImageView
                            android:id="@+id/ivCheckAshar"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_unchecked_circle" />
                        <TextView
                            android:id="@+id/tvTitleAshar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="16dp"
                            android:layout_toEndOf="@id/ivCheckAshar"
                            android:text="Ashar"
                            android:textColor="#1F2937"
                            android:textSize="16sp" />
                        <TextView
                            android:id="@+id/tvStatusAshar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/tvTitleAshar"
                            android:layout_marginStart="16dp"
                            android:layout_toEndOf="@id/ivCheckAshar"
                            android:textColor="#EF4444"
                            android:textSize="12sp"
                            android:visibility="gone" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:text="15:15"
                            android:textColor="#9CA3AF"
                            android:textSize="14sp" />
                    </RelativeLayout>

                    <!-- Maghrib -->
                    <RelativeLayout
                        android:id="@+id/itemMaghrib"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:padding="16dp">
                        <ImageView
                            android:id="@+id/ivCheckMaghrib"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_unchecked_circle" />
                        <TextView
                            android:id="@+id/tvTitleMaghrib"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="16dp"
                            android:layout_toEndOf="@id/ivCheckMaghrib"
                            android:text="Maghrib"
                            android:textColor="#1F2937"
                            android:textSize="16sp" />
                        <TextView
                            android:id="@+id/tvStatusMaghrib"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/tvTitleMaghrib"
                            android:layout_marginStart="16dp"
                            android:layout_toEndOf="@id/ivCheckMaghrib"
                            android:textColor="#EF4444"
                            android:textSize="12sp"
                            android:visibility="gone" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:text="18:10"
                            android:textColor="#9CA3AF"
                            android:textSize="14sp" />
                    </RelativeLayout>

                    <!-- Isya -->
                    <RelativeLayout
                        android:id="@+id/itemIsya"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:padding="16dp">
                        <ImageView
                            android:id="@+id/ivCheckIsya"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_unchecked_circle" />
                        <TextView
                            android:id="@+id/tvTitleIsya"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="16dp"
                            android:layout_toEndOf="@id/ivCheckIsya"
                            android:text="Isya"
                            android:textColor="#1F2937"
                            android:textSize="16sp" />
                        <TextView
                            android:id="@+id/tvStatusIsya"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/tvTitleIsya"
                            android:layout_marginStart="16dp"
                            android:layout_toEndOf="@id/ivCheckIsya"
                            android:textColor="#EF4444"
                            android:textSize="12sp"
                            android:visibility="gone" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:text="19:20"
                            android:textColor="#9CA3AF"
                            android:textSize="14sp" />
                    </RelativeLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Membaca Al-Qur'an"
                android:textColor="#111827"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="80dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeWidth="1dp"
                app:strokeColor="#F3F4F6">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:id="@+id/ivCheckQuran"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_unchecked_circle" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="12dp"
                            android:layout_toEndOf="@id/ivCheckQuran"
                            android:text="Status Membaca"
                            android:textColor="#1F2937"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/quran"
                            app:tint="#9CA3AF" />
                    </RelativeLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="#F9FAFB"
                        android:orientation="vertical"
                        android:padding="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Target Hari Ini:"
                            android:textColor="#6B7280"
                            android:textSize="12sp" />
                        <TextView
                            android:id="@+id/tvTargetQuran"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Belum ditentukan"
                            android:textColor="#111827"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnDetailQuran"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Lihat Detail"
                        android:textAllCaps="false"
                        android:textColor="#059669"
                        app:cornerRadius="8dp"
                        app:strokeColor="#059669" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSimpan"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        android:backgroundTint="#004D40"
        android:text="Simpan Progress"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_save"
        app:iconGravity="textStart"
        app:iconPadding="8dp" />

    <ProgressBar
        android:id="@+id/loadingBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
